{
  "name": "acme/feature-toggles-laravel",
  "description": "Laravel bridge for acme/feature-toggles-core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "acme/feature-toggles-core": "*",
    "illuminate/support": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Acme\\\\FeatureToggles\\\\Laravel\\\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Acme\\\\FeatureToggles\\\\Laravel\\\\FeatureServiceProvider"
      ],
      "aliases": {
        "Feature": "Acme\\\\FeatureToggles\\\\Laravel\\\\Facades\\\\Feature"
      }
    }
  }
}
